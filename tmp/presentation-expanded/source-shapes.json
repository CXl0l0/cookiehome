          "top": 117,
          "width": 500,
          "height": 115
        }
      },
      {
        "id": "4",
        "text": "percentage-point increase in consent",
        "position": {
          "left": 70,
          "top": 244,
          "width": 520,
          "height": 60
        }
      },
      {
        "id": "5",
        "text": "when the first-page opt-out was removed\nNouwens et al., 2020 · 40 participants",
        "position": {
          "left": 70,
          "top": 290,
          "width": 540,
          "height": 80
        }
      },
      {
        "id": "6",
        "text": "Design can influence decisions.",
        "position": {
          "left": 685,
          "top": 185,
          "width": 500,
          "height": 100
        }
      },
      {
        "id": "7",
        "text": "The challenge is to explain cookie\npurposes clearly and preserve\nthe user’s intended choice.",
        "position": {
          "left": 685,
          "top": 290,
          "width": 510,
          "height": 160
        }
      },
      {
        "id": "8",
        "text": "Can we…. gamify it with an analogy?",
