    "id": "hwbqtkby",
    "shapes": [
      {
        "id": "7",
        "text": "Why is it so complicated?",
        "position": {
          "left": 64,
          "top": 42,
          "width": 1150,
          "height": 75
        }
      },
      {
        "id": "2",
        "text": "02",
        "position": {
          "left": 1175,
          "top": 660,
          "width": 60,
          "height": 28
        }
      },
      {
        "id": "4",
        "text": "A website visit begins\nwith a privacy choice",
        "position": {
          "left": 65,
          "top": 188,
          "width": 470,
          "height": 135
        }
      },
      {
        "id": "5",
        "text": "Users’ lack of understanding on privacy settings\nInterface is too verbose\nNot user-friendly interface\nInconvenient\n",
        "position": {
          "left": 65,
          "top": 344.56,
          "width": 480,
          "height": 231.44
        }
      },
      {
        "id": "6",
        "text": "Can this process be simpler?",
        "position": {
          "left": 65,
          "top": 598.4999475065617,
          "width": 1110,
          "height": 55
        }
      }
    ],
