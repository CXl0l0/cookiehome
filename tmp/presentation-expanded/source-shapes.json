  {
    "slide": 4,
    "id": "jyx0ra1s",
    "shapes": [
      {
        "id": "10",
        "text": "It’s not as easy as it sounds",
        "position": {
          "left": 64,
          "top": 42,
          "width": 1150,
          "height": 75
        }
      },
      {
        "id": "2",
        "text": "04",
        "position": {
          "left": 1175,
          "top": 660,
          "width": 60,
          "height": 28
        }
      },
      {
        "id": "11",
        "text": "Simplify without distorting",
        "position": {
          "left": 70,
          "top": 165,
          "width": 445,
          "height": 72
        }
      },
      {
        "id": "12",
        "text": "An analogy must preserve the cookie’s purpose.",
        "position": {
          "left": 550,
          "top": 165,
          "width": 660,
          "height": 80
        }
      },
      {
        "id": "13",
        "text": "Handle uncertain purposes",
        "position": {
          "left": 70,
          "top": 273,
          "width": 445,
          "height": 72
        }
      },
      {
        "id": "14",
        "text": "Missing declarations limit what we can explain.",
        "position": {
          "left": 550,
          "top": 273,
          "width": 660,
          "height": 63
        }
      },
      {
        "id": "15",
        "text": "Interpret ambiguous answers",
        "position": {
          "left": 70,
          "top": 381,
          "width": 445,
          "height": 72
        }
      },
      {
        "id": "16",
        "text": "Answers like “Maybe” doesn’t mean consent.",
        "position": {
          "left": 550,
          "top": 381,
          "width": 660,
          "height": 80
        }
      },
      {
        "id": "17",
        "text": "Make engagement useful",
        "position": {
          "left": 70,
          "top": 489,
          "width": 445,
          "height": 72
        }
      },
      {
        "id": "18",
        "text": "Enjoyment must lead to better understanding.",
        "position": {
          "left": 550,
          "top": 489,
          "width": 660,
          "height": 80
        }
      }
